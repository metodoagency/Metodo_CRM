# Local-only development defaults. Never use this database password in production.
DATABASE_URL=postgresql://metodo:metodo_local_only@127.0.0.1:5432/metodo
DIRECT_URL=postgresql://metodo:metodo_local_only@127.0.0.1:5432/metodo
APP_ORIGIN=http://localhost:5173
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
ALLOWED_EMAILS=owner@example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
# Test auth is unavailable when NODE_ENV=production, regardless of this flag.
E2E_TEST_MODE=false
STORAGE_DRIVER=local
STORAGE_PATH=.local/uploads
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_ENABLED=false
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
GOOGLE_SHEETS_ENABLED=false
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required in production. Separate, independently generated 32-byte base64 keys.
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_ID=primary
FIELD_ENCRYPTION_PREVIOUS_KEYS={}
BLIND_INDEX_KEY=
PLAYWRIGHT_EXECUTABLE_PATH=
CLAMAV_ENABLED=false
TCMB_ENABLED=false
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
DATA_PROVIDER_ENABLED=false
DATA_PROVIDER_API_KEY=
DATA_PROVIDER_LICENSE_NOTE=
