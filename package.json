{
  "name": "metodo-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node --import tsx scripts/generate.ts",
    "dev": "concurrently -k -n api,web \"node --import tsx --watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "start": "node dist/server/server/index.js",
    "db:up": "node --import tsx scripts/db-up.ts",
    "db:stop": "node --import tsx scripts/db-stop.ts",
    "db:migrate": "prisma migrate deploy",
    "seed:example": "node --import tsx prisma/seed.ts",
    "test": "node --import tsx scripts/test.ts",
    "test:unit": "vitest run",
    "test:e2e": "node --import tsx scripts/e2e.ts",
    "lint": "eslint . --max-warnings 0",
    "build": "node --import tsx scripts/build.ts",
    "i18n:check": "node --import tsx scripts/i18n-check.ts",
    "jobs:daily": "node --import tsx server/jobs.ts",
    "typecheck": "tsc --noEmit",
    "compliance:check": "node --import tsx scripts/compliance-check.ts",
    "security:check": "node --import tsx scripts/security-check.ts",
    "a11y": "node --import tsx scripts/e2e.ts --project=a11y",
    "perf:seed": "node --import tsx scripts/perf-seed.ts",
    "keys:rotate": "node --import tsx scripts/keys-rotate.ts",
    "api:docs": "node --import tsx scripts/api-docs.ts",
    "export:subject": "node --import tsx scripts/export-subject.ts",
    "perf:test": "node --import tsx scripts/performance.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "3.1161.0",
    "@aws-sdk/s3-request-presigner": "3.1161.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.8",
    "@fontsource/noto-sans": "5.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tanstack/react-query": "^5.90.2",
    "date-fns": "^4.1.0",
    "docx": "9.15.2",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "file-type": "22.3.0",
    "i18next": "^25.5.2",
    "jose": "^6.1.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "node-cron": "^4.2.1",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "playwright-core": "1.64.1",
    "prisma": "^6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-i18next": "^16.0.0",
    "react-leaflet": "4.2.1",
    "react-router-dom": "^7.18.5",
    "sharp": "0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.56.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.18.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "^8.15.5",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "embedded-postgres": "16.13.0-beta.17",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "jszip": "3.10.2",
    "pdf-parse": "2.4.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^6.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
