{
  "openapi": "3.0.3",
  "info": {
    "title": "Metodo CRM",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {},
    "parameters": {}
  },
  "paths": {
    "/api/clubs": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "city": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "isTracked": {
                    "type": "boolean",
                    "default": false
                  },
                  "relationStatus": {
                    "type": "string",
                    "enum": [
                      "NEW",
                      "WARM",
                      "ACTIVE",
                      "COLD"
                    ],
                    "default": "NEW"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/players": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "primaryPosition": {
                    "type": "string",
                    "enum": [
                      "GK",
                      "CB",
                      "FB",
                      "DM",
                      "CM",
                      "AM",
                      "WF",
                      "CF"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "OWN",
                      "TARGET",
                      "INTERMEDIARY",
                      "MANDATED"
                    ],
                    "default": "TARGET"
                  },
                  "currentClubId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "birthDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "name",
                  "primaryPosition"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/people": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "HEAD_COACH",
                      "ASSISTANT",
                      "GOALKEEPER_COACH",
                      "YOUTH_COORDINATOR",
                      "OFFICIAL",
                      "SCOUT",
                      "OTHER"
                    ],
                    "default": "OTHER"
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/requests": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 160
                  },
                  "clubId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "requesterId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "position": {
                    "type": "string",
                    "enum": [
                      "GK",
                      "CB",
                      "FB",
                      "DM",
                      "CM",
                      "AM",
                      "WF",
                      "CF"
                    ]
                  },
                  "deadline": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "name",
                  "clubId",
                  "requesterId",
                  "position"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      },
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/suggestions": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "requestId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "playerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "personId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "whyGoodTransfer": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 4000
                  },
                  "matchScore": {
                    "type": "number",
                    "nullable": true,
                    "minimum": 0,
                    "maximum": 100,
                    "default": null
                  },
                  "followUpDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "requestId",
                  "playerId",
                  "personId",
                  "whyGoodTransfer"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      }
    },
    "/api/relations": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fromType": {
                    "type": "string",
                    "enum": [
                      "Club",
                      "Player",
                      "Person",
                      "Request"
                    ]
                  },
                  "fromId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "toType": {
                    "type": "string",
                    "enum": [
                      "Club",
                      "Player",
                      "Person",
                      "Request"
                    ]
                  },
                  "toId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "relation": {
                    "type": "string",
                    "enum": [
                      "memberOf",
                      "representedBy",
                      "intermediaryFor",
                      "sellingFor",
                      "mandatedBy",
                      "suggestedTo",
                      "presentedTo",
                      "invitedAs",
                      "attendee",
                      "contactOf",
                      "worksWith",
                      "partnerOf",
                      "usesTool",
                      "hiredBy",
                      "speakerAt",
                      "organizedBy",
                      "scoutedAt",
                      "linkedTo"
                    ]
                  },
                  "role": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "startDate": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "note": {
                    "type": "string",
                    "maxLength": 2000,
                    "default": ""
                  }
                },
                "required": [
                  "fromType",
                  "fromId",
                  "toType",
                  "toId",
                  "relation"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "CSRF or owner restriction"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/proposals": {
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    },
    "/api/trash": {
      "get": {
        "responses": {
          "200": {
            "description": "Owner-scoped response"
          },
          "401": {
            "description": "Unauthenticated"
          }
        }
      }
    }
  }
}
